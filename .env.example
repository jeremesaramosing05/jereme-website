# Copy to .env.local for local dev, and add in Vercel project settings for production.
# Get a free API key at https://resend.com (100 emails/day free).
# Until this is set, the contact form shows a friendly "not configured" message
# with a direct mailto fallback.
RESEND_API_KEY=

# Gated download for the Chess Trainer APK (/api/chess-download).
# CHESS_DOWNLOAD_PASSWORD: the shared access code you give to allowed people.
# GH_RELEASE_TOKEN: a fine-grained GitHub PAT with "Contents: Read" on this
#   repo, used server-side to fetch the private release asset. The repo must be
#   private so the APK isn't publicly downloadable.
CHESS_DOWNLOAD_PASSWORD=
GH_RELEASE_TOKEN=
